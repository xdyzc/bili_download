{
  "manifest_version": 3,
  "name": "Bili Download",
  "version": "0.6.0",
  "description": "Download Bilibili media and record Bilibili, Douyu, and Huya live streams from a persistent side panel.",
  "action": {
    "default_title": "Bili Download"
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://m.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://live.bilibili.com/*",
        "https://www.douyu.com/*",
        "https://www.huya.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "sidePanel",
    "storage",
    "downloads",
    "nativeMessaging"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_media_headers",
        "enabled": true,
        "path": "rules/bili-media-headers.json"
      },
      {
        "id": "live_media_headers",
        "enabled": true,
        "path": "rules/live-media-headers.json"
      }
    ]
  },
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://api.live.bilibili.com/*",
    "https://www.bilibili.com/*",
    "https://m.bilibili.com/*",
    "https://live.bilibili.com/*",
    "https://www.douyu.com/*",
    "https://www.huya.com/*",
    "https://*.douyucdn.cn/*",
    "https://*.flv.huya.com/*",
    "https://*.mobgslb.tbcache.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.hdslb.com/*",
    "https://*.edge.mountaintoys.cn/*"
  ]
}
